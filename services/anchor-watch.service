[Unit]
Description=Anchor watch (circle around the anchor point, alarm + Telegram)
After=network-online.target signalk.service

[Service]
User=pi
ExecStart=/usr/bin/python3 /home/pi/anchor-watch.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

