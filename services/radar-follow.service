[Unit]
Description=Restart OpenCPN when the radar changes address, so it can always command it
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/radar-follow
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target

