[Unit]
Description=Keep exactly one DHCP server on the radar network (stand down when an Axiom appears)
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/radar-net-guard
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target

