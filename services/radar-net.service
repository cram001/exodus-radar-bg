[Unit]
Description=Secondary address on the Raymarine radar network (198.18.0.0/16)
Documentation=without this the Pi has no route to the radar and cannot control it
After=network-online.target
Wants=network-online.target
Before=mayara.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/ip addr replace 198.18.9.200/16 dev eth0
ExecStop=/sbin/ip addr del 198.18.9.200/16 dev eth0

[Install]
WantedBy=multi-user.target

